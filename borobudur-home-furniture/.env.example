# Copy this file to .env.local (untracked by git) and fill in the values
# from your Supabase project's Settings -> API page. Leave both unset (or
# delete .env.local) to keep using the no-backend localStorage/passphrase
# fallback described in the README.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
